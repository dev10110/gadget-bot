# Serves the volume control page (volume_server.py) at boot, on port 8080. Like gadget-phone.service,
# it's a user service so it can change the pi user's PipeWire volume.
#
# Install: cp gadget-volume.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now gadget-volume
# Logs:    journalctl --user-unit gadget-volume -f

[Unit]
Description=Gadget Phone volume control
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
WorkingDirectory=%h/GithubRepos/gadget-bot
ExecStart=/usr/bin/python3 -u volume_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
